# Copy to .env and replace placeholders with your local values.
# Never commit .env or real credentials.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/upsa_collaboration?schema=public"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/upsa_collaboration_test?schema=public"

STORAGE_DIR="./storage"
MAX_UPLOAD_MB="10"

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"

# One-time production bootstrap only. Leave unset except during an approved bootstrap operation.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_CONFIRM=""